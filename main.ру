import telebot
from telebot import types

TOKEN = "8610452108:AAEa5TwM-Lydr526P"
bot = telebot.TeleBot(TOKEN)

ADMIN_USERNAME = "@Master_best19"
user_data = {}

@bot.message_handler(commands=['start'])
def start(message):
    chat_id = message.chat.id
    user_data[chat_id] = {}
    
    markup = types.ReplyKeyboardMarkup(resize_keyboard=True, one_time_keyboard=True)
    markup.add("Круглый", "Квадратный", "Прямоугольный")
    
    bot.send_message(chat_id, "Салом! Келинг, буюртмани шакллантирамиз.\n🍽 Формани танланг:", reply_markup=markup)
    bot.register_next_step_handler(message, get_forma)

def get_forma(message):
    chat_id = message.chat.id
    user_data[chat_id]['forma'] = message.text
    
    markup = types.ReplyKeyboardMarkup(resize_keyboard=True, one_time_keyboard=True)
    markup.add("Классика", "Модерн", "Лофт")
    
    bot.send_message(chat_id, "🎨 Стилни танланг:", reply_markup=markup)
    bot.register_next_step_handler(message, get_style)

def get_style(message):
    chat_id = message.chat.id
    user_data[chat_id]['style'] = message.text
    
    bot.send_message(chat_id, "🖌 Рангни (Цвет) ёзинг:", reply_markup=types.ReplyKeyboardRemove())
    bot.register_next_step_handler(message, get_color)

def get_color(message):
    chat_id = message.chat.id
    user_data[chat_id]['color'] = message.text
    
    bot.send_message(chat_id, "📐 Майдонни (Площадь) ёзинг:")
    bot.register_next_step_handler(message, get_area)

def get_area(message):
    chat_id = message.chat.id
    user_data[chat_id]['area'] = message.text
    
    bot.send_message(chat_id, "📏 Ўлчамни (Размер) ёзинг:")
    bot.register_next_step_handler(message, get_size)

def get_size(message):
    chat_id = message.chat.id
    user_data[chat_id]['size'] = message.text
    
    markup = types.ReplyKeyboardMarkup(resize_keyboard=True, one_time_keyboard=True)
    markup.add("Эконом", "Стандарт", "Премиум")
    
    bot.send_message(chat_id, "💰 Бюджетингизни танланг:", reply_markup=markup)
    bot.register_next_step_handler(message, get_budget)

def get_budget(message):
    chat_id = message.chat.id
    user_data[chat_id]['budget'] = message.text
    
    bot.send_message(chat_id, "👤 Илтимос, исмингизни ёзинг:", reply_markup=types.ReplyKeyboardRemove())
    bot.register_next_step_handler(message, send_lead)

def send_lead(message):
    chat_id = message.chat.id
    user_data[chat_id]['name'] = message.text
    
    data = user_data[chat_id]
    
    report_text = (
        f"🆕 Новая заявка!\n"
        f"👤 Имя: {data.get('name')}\n"
        f"🍽 Форма: {data.get('forma')}\n"
        f"🎨 Стиль: {data.get('style')}\n"
        f"🖌 Цвет: {data.get('color')}\n"
        f"📐 Площадь: {data.get('area')}\n"
        f"📏 Размер: {data.get('size')}\n"
        f"💰 Бюджет: {data.get('budget')}"
    )
    
    try:
        bot.send_message(ADMIN_USERNAME, report_text)
    except Exception as e:
        print(f"Error sending to admin: {e}")

    bot.send_message(chat_id, "Спасибо! Мы свяжемся с вами в ближайшее время ")
    del user_data[chat_id]

bot.infinity_polling()
